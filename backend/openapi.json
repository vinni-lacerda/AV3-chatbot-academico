    },
    "/api/v1/health": {
      "get": {
        "tags": [
          "Infraestrutura"
        ],
        "summary": "Healthcheck da API",
        "description": "Verifica se o serviço backend está ativo e respondendo.",
        "responses": {
          "200": {
            "description": "Serviço operacional",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "Autenticação e Perfis (RF01)"
        ],
        "summary": "Cadastrar novo integrante no projeto (RF01)",
        "description": "Registra um novo integrante no projeto. No cadastro público, o perfil atribuído é sempre novo_integrante por segurança.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterUserRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Integrante cadastrado com sucesso com perfil novo_integrante",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "400": {
            "description": "Erro de validação nos dados de entrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "E-mail já cadastrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "Autenticação e Perfis (RF01)"
        ],
        "summary": "Autenticar integrante e obter token JWT (RF01)",
        "description": "Valida e-mail e senha e retorna um Bearer Token JWT contendo os perfis e permissões calculadas do integrante.",
        "requestBody": {
          "required": true,
          "content": {
