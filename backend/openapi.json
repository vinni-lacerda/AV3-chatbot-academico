{
  "openapi": "3.0.3",
  "info": {
    "title": "Passa o Bastão API",
    "version": "0.1.0",
    "description": "API do chatbot Passa o Bastão para transferência de conhecimento em projetos universitários (Clean Architecture Agnóstica + SOLID + Flask + MongoDB)."
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Servidor de Desenvolvimento Local / Docker"
    }
  ],
  "tags": [
    {
      "name": "Infraestrutura",
      "description": "Monitoramento e disponibilidade do serviço."
    },
    {
      "name": "Autenticação e Perfis (RF01)",
      "description": "Identificação de integrantes, emissão de token JWT e controle de acesso baseado nos perfis: integrante, novo_integrante e responsavel."
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Informe o access_token JWT retornado no endpoint /api/v1/auth/login."
      }
    },
    "schemas": {
      "UserRole": {
        "type": "string",
        "enum": [
          "integrante",
          "novo_integrante",
          "responsavel"
        ],
        "description": "Perfil de acesso do integrante no projeto (RF01)."
      },
      "RegisterUserRequest": {
        "type": "object",
        "required": [
          "name",
          "email",
          "password"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "example": "Rafael Stolf Silva"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "rafael.novo@universidade.edu.br"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "example": "PassaOBastao123!"
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserRole"
            },
            "description": "Opcional. O cadastro público atribui sempre novo_integrante.",
            "example": [
              "novo_integrante"
            ]
          },
          "academic_id": {
            "type": "string",
            "nullable": true,
            "example": "122515186"
          }
        }
      },
      "LoginUserRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "leoni@universidade.edu.br"
          },
          "password": {
            "type": "string",
            "example": "PassaOBastao123!"
          }
        }
      },
      "PermissionsResponse": {
        "type": "object",
        "required": [
          "can_record_knowledge",
          "can_review_knowledge",
          "can_query_knowledge"
        ],
        "properties": {
          "can_record_knowledge": {
            "type": "boolean",
            "example": true
          },
          "can_review_knowledge": {
            "type": "boolean",
            "example": true
          },
          "can_query_knowledge": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "UserResponse": {
        "type": "object",
        "required": [
          "id",
          "name",
          "email",
          "roles",
          "is_active",
          "permissions",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "00000000-0000-4000-8000-000000000003"
          },
          "name": {
            "type": "string",
            "example": "Leoni Lucas Mascarenhas Silva"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "leoni@universidade.edu.br"
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserRole"
            },
            "example": [
              "integrante",
              "responsavel"
            ]
          },
          "academic_id": {
            "type": "string",
            "nullable": true,
            "example": "12725156424"
          },
          "is_active": {
            "type": "boolean",
            "example": true
          },
          "permissions": {
            "$ref": "#/components/schemas/PermissionsResponse"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-08T16:00:00+00:00"
          }
        }
      },
      "AuthTokenResponse": {
        "type": "object",
        "required": [
          "access_token",
          "token_type",
          "user"
        ],
        "properties": {
          "access_token": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          },
          "token_type": {
            "type": "string",
            "example": "bearer"
          },
          "user": {
            "$ref": "#/components/schemas/UserResponse"
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "status",
          "service"
        ],
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "service": {
            "type": "string",
            "example": "passa-o-bastao-backend"
          }
        }
      },
      "ReviewCheckResponse": {
        "type": "object",
        "required": [
          "status",
          "user_id",
          "message"
        ],
        "properties": {
          "status": {
            "type": "string",
            "example": "authorized"
          },
          "user_id": {
            "type": "string",
            "example": "00000000-0000-4000-8000-000000000003"
          },
          "message": {
            "type": "string",
            "example": "Usuário possui permissão de revisão de conhecimentos."
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "detail",
          "error_code"
        ],
        "properties": {
          "detail": {
            "type": "string",
            "example": "Descrição detalhada do erro de negócio."
          },
          "error_code": {
            "type": "string",
            "example": "VALIDATION_ERROR"
          }
        }
      }
    }
  },
  "paths": {
    "/api/v1/activities": {
      "get": {
        "tags": [
          "Conhecimento"
        ],
        "summary": "Listar atividades",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Operação concluída."
          },
          "401": {
            "description": "Identificação ausente ou inválida."
          },
          "default": {
            "description": "Erro na solicitação.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Conhecimento"
        ],
        "summary": "Cadastrar atividade",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Operação concluída."
          },
          "401": {
            "description": "Identificação ausente ou inválida."
          },
          "default": {
            "description": "Erro na solicitação.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "responsible_id": {
                    "type": "string",
                    "format": "uuid"
                  }
                },
                "required": [
                  "title",
                  "description",
                  "responsible_id"
                ]
              }
            }
          }
        }
      }
    },
    "/api/v1/activities/{identifier}": {
      "get": {
        "tags": [
          "Conhecimento"
        ],
        "summary": "Consultar atividade",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Operação concluída."
          },
          "401": {
            "description": "Identificação ausente ou inválida."
          },
          "default": {
            "description": "Erro na solicitação.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "identifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/v1/interview/questions": {
      "get": {
        "tags": [
          "Conhecimento"
        ],
        "summary": "Listar perguntas da entrevista",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Operação concluída."
          },
          "401": {
            "description": "Identificação ausente ou inválida."
          },
          "default": {
            "description": "Erro na solicitação.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/records": {
      "get": {
        "tags": [
          "Conhecimento"
        ],
        "summary": "Listar registros e versões visíveis",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Operação concluída."
          },
          "401": {
            "description": "Identificação ausente ou inválida."
          },
          "default": {
            "description": "Erro na solicitação.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "view",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "library",
                "mine",
                "review"
              ]
            }
          },
          {
            "name": "activity_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "rascunho",
                "pendente",
                "ajustes_solicitados",
                "aprovado",
                "retirado",
                "substituido"
              ]
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ]
      },
      "post": {
        "tags": [
          "Conhecimento"
        ],
        "summary": "Criar rascunho",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Operação concluída."
          },
          "401": {
            "description": "Identificação ausente ou inválida."
          },
          "default": {
            "description": "Erro na solicitação.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "activity_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "entrevista",
                      "documento"
                    ]
                  }
                },
                "required": [
                  "id",
                  "activity_id",
                  "kind"
                ]
              }
            }
          }
        }
      }
    },
    "/api/v1/records/{identifier}/draft": {
      "put": {
        "tags": [
          "Conhecimento"
        ],
        "summary": "Salvar rascunho",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Operação concluída."
          },
          "401": {
            "description": "Identificação ausente ou inválida."
          },
          "default": {
            "description": "Erro na solicitação.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "identifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "version": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "content": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "etapas": {
                            "type": "string"
                          },
                          "recursos": {
                            "type": "string"
                          },
                          "dificuldades": {
                            "type": "string"
                          },
                          "solucoes": {
                            "type": "string"
                          },
                          "decisoes": {
                            "type": "string"
                          },
                          "recomendacoes": {
                            "type": "string"
                          }
                        }
                      },
                      {
                        "type": "object",
                        "properties": {
                          "title": {
                            "type": "string"
                          },
                          "origin": {
                            "type": "string"
                          },
                          "date": {
                            "type": "string",
                            "format": "date"
                          },
                          "text": {
                            "type": "string"
                          }
                        }
                      }
                    ]
                  },
                  "authorized": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "version",
                  "revision",
                  "content"
                ]
              }
            }
          }
        }
      }
    },
    "/api/v1/records/{identifier}/submit": {
      "post": {
        "tags": [
          "Conhecimento"
        ],
        "summary": "Enviar para revisão",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Operação concluída."
          },
          "401": {
            "description": "Identificação ausente ou inválida."
          },
          "default": {
            "description": "Erro na solicitação.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "identifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "version": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "version",
                  "revision"
                ]
              }
            }
          }
        }
      }
    },
    "/api/v1/records/{identifier}/revise": {
      "post": {
        "tags": [
          "Conhecimento"
        ],
        "summary": "Criar nova versão em rascunho",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Operação concluída."
          },
          "401": {
            "description": "Identificação ausente ou inválida."
          },
          "default": {
            "description": "Erro na solicitação.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "identifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "version": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "version",
                  "revision"
                ]
              }
            }
          }
        }
      }
    },
    "/api/v1/records/{identifier}/review": {
      "post": {
        "tags": [
          "Conhecimento"
        ],
        "summary": "Aprovar, solicitar ajustes ou retirar",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Operação concluída."
          },
          "401": {
            "description": "Identificação ausente ou inválida."
          },
          "default": {
            "description": "Erro na solicitação.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "identifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "version": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "decision": {
                    "type": "string",
                    "enum": [
                      "aprovado",
                      "ajustes_solicitados",
                      "retirado"
                    ]
                  },
                  "note": {
                    "type": "string"
                  }
                },
                "required": [
                  "version",
                  "revision",
                  "decision"
                ]
              }
            }
          }
        }
      }
    },
    "/api/v1/sources/{identifier}/{version}": {
      "get": {
        "tags": [
          "Conhecimento"
        ],
        "summary": "Inspecionar fonte aprovada",
